#!/bin/bash
set -euxo pipefail

# Ensure amazon-ssm-agent starts immediately in the background upon boot so it registers with AWS Systems Manager
systemctl enable --now amazon-ssm-agent || true
systemctl restart amazon-ssm-agent || true

dnf update -y
dnf install -y httpd php php-mysqlnd php-cli php-opcache php-gd jq unzip mariadb105

# Pull DB connection details from Secrets Manager (assignment-db-credentials)
# using this instance's IAM role - no credentials are ever hardcoded here.
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region "${aws_region}" \
  --query SecretString --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv S3_BUCKET "${artifact_bucket}"
SetEnv AWS_S3_BUCKET "${artifact_bucket}"
SetEnv AWS_REGION "${aws_region}"
SetEnv AWS_S3_REGION "${aws_region}"
SetEnv SNS_TOPIC_ARN "${sns_topic_arn}"
SetEnv CDN_DOMAIN "${cdn_domain}"
SetEnv AWS_CDN_DOMAIN "${cdn_domain}"
EOF

# Performance tuning: enable Gzip compression and browser caching for static assets
cat <<'EOF' > /etc/httpd/conf.d/performance.conf
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>
EOF

# Performance tuning: tune PHP OPcache for high-throughput user surges
cat <<'EOF' > /etc/php.d/10-opcache.ini
zend_extension=opcache
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption=128
opcache.interned_strings_buffer=16
opcache.max_accelerated_files=10000
opcache.revalidate_freq=2
opcache.validate_timestamps=1
opcache.fast_shutdown=1
EOF

# Route/testimonial photo uploads: PHP's stock defaults (upload_max_filesize
# 2M, post_max_size 8M on this AMI) are well below a typical phone photo.
# When a POST body exceeds post_max_size, PHP silently drops the entire
# $_POST/$_FILES superglobals - including the CSRF token field - which
# surfaces here as a misleading "Invalid or expired request token" error
# on every image upload, rather than any clear "file too large" message.
cat <<'EOF' > /etc/php.d/20-uploads.ini
upload_max_filesize = 20M
post_max_size = 25M
EOF

mkdir -p /var/www/html

# Self-healing deploy: every new/replaced instance (scale-out, instance
# refresh, terraform apply after a destroy, etc.) pulls whatever was last
# shipped by the deploy.yml workflow, so the fleet never drifts back to the
# placeholder page after the first real deploy. Falls back to a placeholder
# only before any deploy has ever run.
if aws s3api head-object --bucket "${artifact_bucket}" --key "${artifact_key}" --region "${aws_region}" >/dev/null 2>&1; then
  aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/assignment-app.zip --region "${aws_region}"
  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html
  mkdir -p /var/www/html/uploads
  chown -R apache:apache /var/www/html
  chmod -R 775 /var/www/html/uploads || true

  # Auto-seed database if tables do not exist
  if [ -f /var/www/html/schema.sql ]; then
    TABLE_COUNT=$(MYSQL_PWD="$DB_PASS" mysql -h "$DB_HOST" -u "$DB_USER" -D "$DB_NAME" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='users';" 2>/dev/null || echo "0")
    if [ "$TABLE_COUNT" -eq 0 ]; then
      MYSQL_PWD="$DB_PASS" mysql -h "$DB_HOST" -u "$DB_USER" < /var/www/html/schema.sql 2>/dev/null || true
    fi
  fi
else
  echo "<?php http_response_code(200); echo 'assignment-shuttle-bus-ticketing: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php
  # Matches healthz.php's contract (no DB dependency) so the ALB target group
  # already sees this instance as healthy before the first real deploy.
  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php
fi

# Ensure amazon-ssm-agent is actively running and registered with AWS Systems Manager
systemctl enable --now amazon-ssm-agent || true
systemctl restart amazon-ssm-agent || true

systemctl enable httpd
systemctl restart httpd

