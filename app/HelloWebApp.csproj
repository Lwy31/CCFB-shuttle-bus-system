<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>HelloWebApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local dev convenience only — CI overwrites this with the real
         commit SHA before `dotnet publish`, see build.yml. Uses Update (not
         Include) because the web SDK already picks up .json as Content. -->
    <Content Update="deployment.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
